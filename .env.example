# ---- Homebox ----------------------------------------------------------------
# Only used by the bundled Homebox container. Generate with: openssl rand -base64 48
# Keep it the same forever: changing it invalidates every Homebox API key.
HBOX_AUTH_API_KEY_PEPPER=

# Where Box Inventory finds Homebox. The default works with docker-compose.yml.
HOMEBOX_URL=http://homebox:7745
# Homebox's address as your phone sees it, for "Open in Homebox" links (optional).
HOMEBOX_PUBLIC_URL=

# Log in with an API key (Homebox: Profile -> API keys) ...
HOMEBOX_API_KEY=
# ... or with a username and password instead.
HOMEBOX_USERNAME=
HOMEBOX_PASSWORD=

# ---- Claude -----------------------------------------------------------------
# From https://platform.claude.com -> API keys
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high. Higher is more thorough but slower and costs more.
CLAUDE_EFFORT=medium

# ---- Boxes ------------------------------------------------------------------
# Boxes are created inside this Homebox location (created if missing).
# Leave empty to put boxes at the top level.
PARENT_LOCATION=Storage Unit
# How a box number becomes a location name: 42 -> "Box 042"
BOX_NAME_FORMAT=Box {n}
BOX_NUMBER_DIGITS=3
# Save your spoken description in the box's notes in Homebox.
SAVE_TRANSCRIPT=true

# ---- This app ---------------------------------------------------------------
# Password for the Box Inventory page (any username). Set this if the page is
# reachable from outside your home network.
APP_PASSWORD=
